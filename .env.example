# JobCenter Docker — copy to .env and fill. Do NOT commit .env
# Required: generate with: openssl rand -hex 32  (or PowerShell: [Convert]::ToHexString((1..32|%{Get-Random -Max 256})))
POSTGRES_PASSWORD=changeme-postgres-32hex
REDIS_PASSWORD=changeme-redis-32hex
JWT_SECRET=changeme-jwt-64hex-min32

# Ports (host)
API_PORT=3001
NGINX_PORT=8081
POSTGRES_PORT=5433
REDIS_PORT=6380

# Cloudflare Tunnel — leave empty for local-only, or set TUNNEL_TOKEN from dash.cloudflare.com
# Quick tunnel (no domain): run `docker run cloudflare/cloudflared tunnel --url http://host.docker.internal:8081` manually
TUNNEL_TOKEN=

# Hunter interval override (ms) — default 300000 (5m) in code
HUNTER_INTERVAL_MS=300000

# Auto-tailoring — OFF. The hunters used to queue a CV+letter for every offer
# scoring >= 3, which filled the Documents tab with 68 unwanted pairs. Documents
# are now generated only when the user asks ("adapter <ref>" in the chat or the
# "Adapter" button on an offer). Set to 1 to restore the automatic behaviour;
# AUTO_TAILOR_SCORE tunes the match-score threshold (default 3).
# NOTE: the hunter agents are host processes started by app/daemon/monitor.js,
# which does not read .env — export these in the shell that launches monitor.js.
AUTO_TAILOR=0
AUTO_TAILOR_SCORE=3

# Hotline — chat wires directly into this project's opencode server (host daemon)
OPENCODE_HOTLINE_URL=http://127.0.0.1:4096
OPENCODE_HOTLINE_PORT=4096
# Same model as the opencode TUI; override if the serve instance resolves a different one
OPENCODE_HOTLINE_MODEL=opencode/big-pickle
# Optional basic auth for the hotline server (username defaults to "opencode")
OPENCODE_SERVER_PASSWORD=
# ---- Hotline streaming (chat-bot.docker.js) ---------------------------------
# 1 = fire the prompt without waiting and read the answer off the session SSE
# stream. Nothing holds an HTTP request open for the length of a turn, which is
# what used to kill every turn past 5 minutes (undici's built-in 300s headers
# timeout -> "fetch failed", 37 times on 2026-09-28).
# Set to 0 to fall back to the old blocking POST (not recommended).
OPENCODE_HOTLINE_STREAM=1
# 1 = a message sent while a turn runs is steered into it (delivery: 'steer')
# instead of queueing behind it.
OPENCODE_HOTLINE_STEER=1
# 'once' (default) auto-approves each tool permission the agent asks for.
# 'off' leaves the prompt unanswered and the turn stalls until the deadline.
# 'always' also remembers the approval.
OPENCODE_HOTLINE_AUTOPERM=once
# Hard ceiling per turn; on expiry the turn is interrupted and whatever text
# arrived is returned. 20 min.
OPENCODE_HOTLINE_DEADLINE_MS=1200000
# Minimum gap between two "📝 still working" notes in the chat.
OPENCODE_HOTLINE_PROGRESS_MS=15000
# If the primary model rejects requests (provider HTTP 4xx), fail over to this one
# for HOTLINE_MODEL_COOLDOWN_MS instead of failing the turn.
OPENCODE_HOTLINE_FALLBACK_MODEL=opencode/longcat-2.5-preview-free
# How long to stay on the fallback before retrying the primary (10 min).
OPENCODE_HOTLINE_MODEL_COOLDOWN_MS=600000
# The prompt endpoint has no per-turn "done" event, so a turn is considered finished
# when no step is running, nothing arrives for this long, and the server reports
# the session idle. Must cover the model's thinking pauses between steps (10s).
# Raise it if answers still cut off mid-task; lower it to feel replies sooner.
OPENCODE_HOTLINE_QUIET_MS=10000
# How many times to re-attach the SSE stream (with ?after=) before giving up.
OPENCODE_HOTLINE_SSE_ATTEMPTS=3
# Only used by the legacy blocking path (OPENCODE_HOTLINE_STREAM=0). 0 = no abort;
# it cannot raise undici's 300s ceiling either way.
OPENCODE_HOTLINE_TIMEOUT_MS=0
# ---- FCM push (app/daemon/push.js) ----------------------------------------
# Tuned 2026-09-28 after "FCM is too noisy, and no new-offer alerts": the sender
# had no dedup at all, so an identical title+body always produced a new
# notification, and the offer digest was dead code (never called).
# NOTE: like AUTO_TAILOR, monitor.js does not read .env - export these in the
# shell that launches monitor.js.
#
# Minutes an identical push (same tag+title+body) stays suppressed.
PUSH_DEDUP_MIN=15
# Local quiet window. Non-urgent tags (offer, task_done) are queued and
# released when the window ends; apply_* and agent_action break through.
PUSH_QUIET_START=23
PUSH_QUIET_END=7
# Minutes between offer digests (one push listing up to 3 new relevant offers).
PUSH_DIGEST_MIN=30
# What the CHAT may push. `off` is the default (2026-09-30) and only the offers
# digest, task_done and the apply_* alerts notify -- no chat/agent push at all.
#   off          = never push a chat reply (default)
#   action_only  = also push a question/blocker (❓/❌)
#   all          = also push informational replies (✅/📝)
# Any other value is treated as off. The app raises its own local notification
# for chat messages too (app/jobcenter/lib/main.dart, kChatLocalNotify), so
# flipping this to action_only only works together with that flag = true.
PUSH_CHAT_MODE=off

# --- Semantic relevance band (2026-10-04) ---
# Stages offers the keyword engine rejected so an LLM can give a second opinion.
# NOTE: monitor.js does NOT read .env. The values that matter are passed to the
# fleet and the relevance worker via app/daemon/agents.json (env blocks), which
# is the only path that reaches those processes. Change them there, not here.
# RELEVANCE_BAND=1                  # kill switch for band enrichment + inserts
# RELEVANCE_BAND_MIN_DESC=200       # min description length worth classifying
# RELEVANCE_BAND_ENRICH_MAX=40      # per-source-crawl description fetch cap
# RELEVANCE_BAND_MAX_PER_SOURCE=25  # per-source-crawl band insert cap
# RELEVANCE_BAND_TTL_DAYS=21       # API-side TTL for un-judged band offers
# RELEVANCE_BATCH=10                # offers per classifier call
# RELEVANCE_INTERVAL_MS=300000      # worker cadence
# RELEVANCE_MAX_TRIES=3             # give up after N failed judgements
#
# --- Tier-0 deterministic gate (2026-10-05) ---
# Runs on every pass, BEFORE any provider is consulted, and writes rule-based
# REJECTS only. Measured against the 1,087 offers the LLM had already decided:
# 563/563 correct, zero promotions deleted, covering 51.8% of them. Those rows
# never enter the token budget, never consume bandTries, and still drain when no
# provider key is configured -- which is what unblocked the stalled band.
# It cannot promote. The promote rule measured 17.6% precision and stays off.
# See app/daemon/offer-gate.js and scripts/measure-gates.js.
# RELEVANCE_TIER0_GATE=1             # 0 disables the gate entirely
# RELEVANCE_GATE_CLAIM_MULT=6        # claim RELEVANCE_BATCH x this when the gate runs
# RELEVANCE_PASS_BUDGET_MS=600000    # wall-clock cap on one pass (10 min)
# RELEVANCE_LOCAL_FALLBACK=1         # legacy alias honoured when TIER0_GATE is unset
